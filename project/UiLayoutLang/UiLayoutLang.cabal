cabal-version: 3.0
name: UiLayoutLang
version: 0.1.0.0
build-type: Simple

library
  exposed-modules:
      UiLayoutLang.Types
      UiLayoutLang.Parser
      UiLayoutLang.Engine
      UiLayoutLang.Render
  hs-source-dirs: src
  build-depends:
      base >=4.14 && <5,
      megaparsec >=9,
      parser-combinators,
      text
  default-language: Haskell2010
  ghc-options: -Wall

executable uilayoutlang
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
      base >=4.14 && <5,
      UiLayoutLang
  default-language: Haskell2010
  ghc-options: -Wall

test-suite uilayoutlang-test
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  build-depends:
      base >=4.14 && <5,
      UiLayoutLang,
      hspec,
      QuickCheck
  default-language: Haskell2010
  ghc-options: -Wall
